# Postgres connection string used by honeylog and your own routes.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# Copy this file to .env and fill in real values. NEVER commit .env.
PSQL_HOST="localhost"
PSQL_PORT=5432
PSQL_USER="<your_username>"
PSQL_PASSWORD="<your_password>"
PSQL_DATABASE="<your_database>"
PSQL_SCHEMA="<your_schema>"

# Optional: override the default port (3000) the example listens on.
# PORT=3000
