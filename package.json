{
  "name": "honeylog",
  "version": "0.1.0",
  "description": "Threat-detection and request-fingerprinting middleware for Express. Catches scanners, classifies attack patterns, and gives you a defensible audit log.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./patterns": {
      "types": "./dist/middleware/threatDefinitions.d.ts",
      "import": "./dist/middleware/threatDefinitions.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "echo \"No tests yet\" && exit 0",
    "typecheck": "tsc --noEmit",
    "backtest": "tsx src/tools/backtest-strategies.ts",
    "migrate:up": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "migrate:status": "tsx src/migrate.ts status",
    "migrate:reset": "tsx src/migrate.ts reset"
  },
  "keywords": [
    "express",
    "middleware",
    "security",
    "honeypot",
    "threat-detection",
    "waf",
    "scanner-detection",
    "appsec",
    "logging",
    "owasp"
  ],
  "author": "Jason Cox",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "pg": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "jsonwebtoken": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaywalked78/honeylog.git"
  },
  "bugs": {
    "url": "https://github.com/jaywalked78/honeylog/issues"
  },
  "homepage": "https://github.com/jaywalked78/honeylog#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "maxmind": "^5.0.6"
  }
}
